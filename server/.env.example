# MongoDB Atlas Connection
# IMPORTANT: Never commit real credentials. Use a strong, unique password.
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/employee_management?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Reverse proxy (optional): set only when the API runs behind a proxy, to the
# number of proxy hops (e.g. 1) or the proxy's address/subnet (e.g. loopback).
# Leaving it unset when there is no proxy keeps clients from spoofing their IP.
# TRUST_PROXY=1
